# Root helper for the VPN Switch GNOME extension (same steps as the original scripts).
# Usage: vpn-switch-helper tailscale|netbird|off
set -u
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
case "${1:-}" in
  tailscale|netbird|off) ;;
  *) echo "usage: $0 tailscale|netbird|off" >&2; exit 2 ;;
esac
netbird down
tailscale down
# Let the daemons finish tearing down their DNS config before resetting the resolver.
sleep 2
systemctl restart systemd-resolved
resolvectl flush-caches
case "$1" in
  tailscale) tailscale up ;;
  netbird)   netbird up ;;
esac
